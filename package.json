{
  "name": "oxc",
  "version": "1.0.0",
  "description": "oxc config for linting and formatting",
  "exports": {
    "./oxlint": "./src/oxlint.ts",
    "./oxfmt": "./src/oxfmt.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "dependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005"
  }
}
